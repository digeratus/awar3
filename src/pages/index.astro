---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "AWAR3 | Confidential skunkworks for advanced systems";
const description =
  "AWAR3 is a confidential skunkworks for advanced systems across hardware, AI, autonomy, sensing, simulation, and operations.";

const theaters = [
  {
    label: "Hardware",
    title: "Physical systems under real constraints",
    copy:
      "Instrumentation, devices, edge systems, sensing, and field-ready prototypes where signal, latency, power, and material limits matter.",
    tags: ["Sensing", "Edge", "Devices"]
  },
  {
    label: "AI",
    title: "Models tied to operational consequence",
    copy:
      "Applied AI, data systems, decision loops, simulation, and autonomous workflows built around feedback, trust, and measurable effect.",
    tags: ["Models", "Simulation", "Decision"]
  },
  {
    label: "Systems",
    title: "The whole machine, not one component",
    copy:
      "Complex dependencies, interfaces, failure modes, incentives, and organizational realities made visible enough to engineer against.",
    tags: ["Interfaces", "Failure modes", "Operations"]
  }
];

const capabilities = [
  {
    code: "A-01",
    title: "Advanced Systems",
    copy:
      "Build the technical artifact that makes the hardest uncertainty concrete: prototype, model, rig, simulator, or operating loop."
  },
  {
    code: "B-17",
    title: "Autonomy And Sensing",
    copy:
      "Connect hardware, perception, AI, and control into systems that can be tested against the physical world instead of a slide deck."
  },
  {
    code: "C-42",
    title: "Computational Leverage",
    copy:
      "Represent the problem clearly enough that better prototypes, sharper decisions, and cleaner execution become possible."
  }
];

const method = [
  {
    step: "01",
    title: "Frame",
    copy:
      "Map the true operating theater: constraints, interfaces, stakeholders, data, hardware, failure modes, and the decisive unknown."
  },
  {
    step: "02",
    title: "Prototype",
    copy:
      "Build a prototype that exposes the constraint. Small enough to move quickly, serious enough to survive contact with reality."
  },
  {
    step: "03",
    title: "Flight-Test",
    copy:
      "Run the prototype against the relevant environment, instrument the result, and separate signal from theater."
  },
  {
    step: "04",
    title: "Transfer",
    copy:
      "Harden the result, document the operating logic, and leave behind capability rather than dependency."
  }
];

const principles = [
  "Small senior teams with direct technical ownership.",
  "First-principles framing before inherited process.",
  "Hardware, AI, data, people, and operations treated as one system.",
  "Confidential by default; public proof is not the product.",
  "Every engagement should sharpen the client's internal capability."
];
---

<BaseLayout title={title} description={description}>
  <header class="site-header">
    <div class="shell header-grid">
      <a class="brand" href="#top" aria-label="AWAR3 home">
        <span class="brand-mark" aria-hidden="true">A3</span>
        <span>AWAR3</span>
      </a>
      <button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-label="Open navigation">
        <span></span>
        <span></span>
        <span></span>
      </button>
      <nav class="nav" data-nav>
        <a href="#theater">Theater</a>
        <a href="#method">Method</a>
        <a href="#notes">Field Notes</a>
        <a href="#contact">Contact</a>
      </nav>
    </div>
  </header>

  <main id="main">
    <section class="hero" id="top">
      <div class="shell hero-grid">
        <div class="hero-copy" data-reveal>
          <p class="kicker">Confidential Skunkworks / Advanced Systems</p>
          <h1>Make the impossible buildable.</h1>
          <p class="lede">
            AWAR3 is a confidential skunkworks for funded startups and established teams
            when the project is too new, too hard, or too far outside the normal org chart.
          </p>
          <div class="hero-actions">
            <a class="btn primary" href="mailto:info@awar3.com?subject=AWAR3%20confidential%20inquiry" aria-label="Start a confidential inquiry by emailing info@awar3.com">Start a confidential inquiry</a>
            <a class="btn secondary" href="#method">Review the method</a>
          </div>
          <dl class="signal-strip" aria-label="AWAR3 operating profile">
            <div>
              <dt>Profile</dt>
              <dd>Small senior teams</dd>
            </div>
            <div>
              <dt>Mode</dt>
              <dd>Confidential by default</dd>
            </div>
            <div>
              <dt>Field</dt>
              <dd>Hardware / AI / Systems</dd>
            </div>
          </dl>
          <p class="contact-note">Opens your email app with a prefilled AWAR3 inquiry.</p>
        </div>

        <div class="blueprint" aria-label="Aerospace systems blueprint" data-reveal>
          <div class="blueprint-head">
            <span>AWAR3 / Systems Schematic</span>
            <span>Rev. 03</span>
          </div>
          <svg class="blueprint-diagram" viewBox="0 0 620 520" role="img" aria-label="Schematic of connected hardware, AI, and systems modules">
            <defs>
              <pattern id="microgrid" width="24" height="24" patternUnits="userSpaceOnUse">
                <path d="M 24 0 L 0 0 0 24" fill="none" />
              </pattern>
            </defs>
            <rect width="620" height="520" class="grid-fill"></rect>
            <path class="orbit" d="M93 323 C137 116 352 54 496 157 C608 238 544 401 378 438 C225 472 75 413 93 323Z"></path>
            <path class="datum" d="M62 262 H558 M310 54 V470"></path>
            <g class="module module-a">
              <rect x="92" y="112" width="146" height="84"></rect>
              <text x="112" y="145">HARDWARE</text>
              <text x="112" y="169">SENSING / EDGE</text>
            </g>
            <g class="module module-b">
              <rect x="368" y="104" width="158" height="96"></rect>
              <text x="388" y="141">AI CORE</text>
              <text x="388" y="165">MODELS / DATA</text>
            </g>
            <g class="module module-c">
              <rect x="226" y="330" width="180" height="96"></rect>
              <text x="246" y="367">OPS LOOP</text>
              <text x="246" y="391">TEST / TRANSFER</text>
            </g>
            <path class="wire" d="M238 154 C282 118 323 116 368 152"></path>
            <path class="wire" d="M447 200 C438 275 401 324 366 330"></path>
            <path class="wire" d="M226 365 C162 342 127 282 152 196"></path>
            <circle class="node node-one" cx="238" cy="154" r="8"></circle>
            <circle class="node node-two" cx="447" cy="200" r="8"></circle>
            <circle class="node node-three" cx="316" cy="330" r="8"></circle>
            <path class="vehicle" d="M309 246 L360 274 L309 303 L260 274 Z"></path>
            <path class="vehicle-lines" d="M309 246 V303 M260 274 H360"></path>
          </svg>
          <div class="blueprint-foot">
            <span>Flight Readiness: Decisive Unknown</span>
            <span>Clearance: Need To Know</span>
          </div>
        </div>
      </div>
    </section>

    <section class="section theater" id="theater">
      <div class="shell">
        <div class="section-heading" data-reveal>
          <p class="kicker">Operating Theater</p>
          <h2>Where hardware, AI, and the whole system meet.</h2>
          <p>
            AWAR3 is built for work that does not belong cleanly to one team, one model, one device, or one roadmap.
          </p>
        </div>

        <div class="mission-board" data-mission-board data-reveal>
          <div class="mission-tabs" role="tablist" aria-label="Operating theaters">
            {
              theaters.map((item, index) => (
                <button
                  class={index === 0 ? "mission-tab active" : "mission-tab"}
                  type="button"
                  role="tab"
                  aria-selected={index === 0 ? "true" : "false"}
                  data-tab-index={index}
                >
                  {item.label}
                </button>
              ))
            }
          </div>
          <div class="mission-output" data-mission-output>
            <p class="readout">Selected Field / 01</p>
            <h3>{theaters[0].title}</h3>
            <p>{theaters[0].copy}</p>
            <div class="tag-row">
              {theaters[0].tags.map((tag) => <span>{tag}</span>)}
            </div>
          </div>
          <script is:inline type="application/json" data-mission-payload set:html={JSON.stringify(theaters)} />
        </div>

        <div class="capability-grid">
          {
            capabilities.map((item) => (
              <article class="capability" data-reveal>
                <span>{item.code}</span>
                <h3>{item.title}</h3>
                <p>{item.copy}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section method" id="method">
      <div class="shell">
        <div class="section-heading compact" data-reveal>
          <p class="kicker">Method</p>
          <h2>From ambiguity to a tested artifact.</h2>
        </div>
        <div class="method-line">
          {
            method.map((item) => (
              <article class="method-step" data-reveal>
                <span>{item.step}</span>
                <h3>{item.title}</h3>
                <p>{item.copy}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section notes" id="notes">
      <div class="shell notes-grid">
        <div class="field-note" data-reveal>
          <p class="kicker">Field Notes</p>
          <h2>Designed for unusual work.</h2>
          <p>
            The work may begin as a stalled technical bet, a sensing problem, an autonomous workflow,
            a messy operational system, or a capability no existing team is structured to own.
          </p>
        </div>
        <ol class="principles" data-reveal>
          {principles.map((item) => <li>{item}</li>)}
        </ol>
      </div>
    </section>

    <section class="section contact" id="contact">
      <div class="shell contact-grid">
        <div data-reveal>
          <p class="kicker">Contact</p>
          <h2>Bring the hard part.</h2>
          <p>
            No public client roll, no showroom claims. Start with the constraint, the desired capability,
            and the reason the normal path has not worked.
          </p>
        </div>
        <aside class="contact-panel" data-reveal>
          <span>AWAR3 / Secure First Contact</span>
          <a href="mailto:info@awar3.com?subject=AWAR3%20confidential%20inquiry">info@awar3.com</a>
          <p>Confidential skunkworks for advanced systems.</p>
          <address>
            <strong>AWAR3</strong>
            <span>215 E 99th St., Suite 310</span>
            <span>New York, NY 10029</span>
          </address>
        </aside>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="shell">
      <span>(c) 2026 AWAR3</span>
      <a href="#top">Back to top</a>
    </div>
  </footer>

  <script>
    const initAWAR3 = () => {
      const navToggle = document.querySelector("[data-nav-toggle]");
      const nav = document.querySelector("[data-nav]");
      if (navToggle instanceof HTMLButtonElement && nav instanceof HTMLElement) {
        navToggle.onclick = () => {
          const open = nav.classList.toggle("open");
          navToggle.setAttribute("aria-expanded", String(open));
        };
        nav.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", () => {
            nav.classList.remove("open");
            navToggle.setAttribute("aria-expanded", "false");
          });
        });
      }

      const revealItems = document.querySelectorAll("[data-reveal]");
      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.14 }
        );
        revealItems.forEach((item) => observer.observe(item));
      } else {
        revealItems.forEach((item) => item.classList.add("is-visible"));
      }

      const board = document.querySelector("[data-mission-board]");
      const output = board?.querySelector("[data-mission-output]");
      const payloadNode = board?.querySelector("[data-mission-payload]");
      const tabs = Array.from(board?.querySelectorAll("[data-tab-index]") || []);
      if (board && output instanceof HTMLElement && payloadNode?.textContent) {
        const payload = JSON.parse(payloadNode.textContent);
        tabs.forEach((tab) => {
          tab.addEventListener("click", () => {
            const index = Number(tab.getAttribute("data-tab-index") || "0");
            const item = payload[index] as { title: string; copy: string; tags: string[] };
            tabs.forEach((candidate) => {
              const active = candidate === tab;
              candidate.classList.toggle("active", active);
              candidate.setAttribute("aria-selected", String(active));
            });
            output.innerHTML = `
              <p class="readout">Selected Field / ${String(index + 1).padStart(2, "0")}</p>
              <h3>${item.title}</h3>
              <p>${item.copy}</p>
              <div class="tag-row">${item.tags.map((tag: string) => `<span>${tag}</span>`).join("")}</div>
            `;
          });
        });
      }
    };

    document.addEventListener("astro:page-load", initAWAR3);
    initAWAR3();
  </script>
</BaseLayout>
