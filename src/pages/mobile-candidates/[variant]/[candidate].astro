---
import MobileCandidatePage from "../../../components/MobileCandidatePage.astro";
import { mobileCandidates, type MobileCandidate } from "../../../lib/mobile-candidates";
import { siteContent } from "../../../content/site";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { isVariant, variantNames, variants, type Variant } from "../../../lib/variants";

export function getStaticPaths() {
  return variants.flatMap((variant) =>
    mobileCandidates.map((candidate) => ({ params: { variant, candidate }, props: { variant, candidate } }))
  );
}

interface Props {
  variant: Variant;
  candidate: MobileCandidate;
}

const { variant, candidate } = Astro.props;
if (!isVariant(variant)) throw new Error("Invalid mobile candidate variant");
---

<BaseLayout
  title={`${variantNames[variant]} mobile candidate ${candidate.toUpperCase()} | AWAR3`}
  description={siteContent.metadata.description}
  variant={variant}
  robots="noindex,nofollow,noarchive"
  skipTarget="candidate"
>
  <MobileCandidatePage variant={variant} candidate={candidate} />
</BaseLayout>
