---
import { siteContent as content } from "../content/site";
import { variantNames, type Variant } from "../lib/variants";

interface Props {
  variant: Variant;
}

type Box = { left: number; top: number; width: number; height: number };

const { variant } = Astro.props;
const boardByVariant = {
  "field-station": { src: "/designs/field-station.webp", width: 1440, height: 3601 },
  "airborne-workshop": { src: "/designs/airborne-workshop.webp", width: 1440, height: 3295 },
  "living-systems": { src: "/designs/living-systems.webp", width: 1440, height: 3113 },
  "industrial-hybrid": { src: "/designs/industrial-hybrid.webp", width: 1440, height: 4049 }
} as const;

const anchorTops: Record<Variant, Record<"work" | "rethink" | "method" | "contact", number>> = {
  "field-station": { work: 21.5, rethink: 32.1, method: 66.2, contact: 84.2 },
  "airborne-workshop": { work: 21.7, rethink: 33.8, method: 69.0, contact: 87.6 },
  "living-systems": { work: 24.1, rethink: 35.4, method: 74.0, contact: 87.5 },
  "industrial-hybrid": { work: 24.2, rethink: 32.2, method: 66.2, contact: 86.7 }
};

const navBoxes: Record<Variant, Record<"work" | "rethink" | "method" | "contact", Box>> = {
  "field-station": {
    work: { left: 39.4, top: 0.5, width: 6.4, height: 2.5 },
    rethink: { left: 46.1, top: 0.5, width: 7.0, height: 2.5 },
    method: { left: 53.5, top: 0.5, width: 6.8, height: 2.5 },
    contact: { left: 60.6, top: 0.5, width: 7.0, height: 2.5 }
  },
  "airborne-workshop": {
    work: { left: 33.0, top: 0.45, width: 6.0, height: 2.4 },
    rethink: { left: 39.0, top: 0.45, width: 6.8, height: 2.4 },
    method: { left: 45.8, top: 0.45, width: 6.8, height: 2.4 },
    contact: { left: 52.8, top: 0.45, width: 6.6, height: 2.4 }
  },
  "living-systems": {
    work: { left: 36.2, top: 0.45, width: 5.7, height: 2.3 },
    rethink: { left: 42.0, top: 0.45, width: 6.6, height: 2.3 },
    method: { left: 48.7, top: 0.45, width: 6.5, height: 2.3 },
    contact: { left: 55.4, top: 0.45, width: 6.5, height: 2.3 }
  },
  "industrial-hybrid": {
    work: { left: 55.5, top: 0.2, width: 7.0, height: 1.8 },
    rethink: { left: 64.0, top: 0.2, width: 8.0, height: 1.8 },
    method: { left: 74.0, top: 0.2, width: 7.0, height: 1.8 },
    contact: { left: 83.0, top: 0.2, width: 7.0, height: 1.8 }
  }
};

const ctaBoxes: Record<Variant, Box[]> = {
  "field-station": [
    { left: 4.5, top: 17.3, width: 22.8, height: 2.3 },
    { left: 48.6, top: 91.5, width: 28.7, height: 2.4 }
  ],
  "airborne-workshop": [
    { left: 6.0, top: 17.9, width: 27.2, height: 2.3 },
    { left: 47.4, top: 91.9, width: 27.0, height: 2.4 }
  ],
  "living-systems": [
    { left: 58.2, top: 20.6, width: 24.2, height: 2.3 },
    { left: 51.5, top: 91.2, width: 25.5, height: 2.5 }
  ],
  "industrial-hybrid": [
    { left: 4.0, top: 17.4, width: 25.2, height: 2.2 },
    { left: 5.0, top: 91.0, width: 29.0, height: 2.5 }
  ]
};

const emailBoxes: Record<Variant, Box> = {
  "field-station": { left: 50.0, top: 94.1, width: 18.0, height: 1.4 },
  "airborne-workshop": { left: 48.0, top: 94.5, width: 18.0, height: 1.4 },
  "living-systems": { left: 52.0, top: 94.2, width: 18.0, height: 1.4 },
  "industrial-hybrid": { left: 4.0, top: 94.0, width: 24.0, height: 1.4 }
};

const board = boardByVariant[variant];
const mailto = `mailto:${content.contact.email}?subject=AWAR3%20confidential%20inquiry`;
const boxStyle = (box: Box) => `--left:${box.left}%;--top:${box.top}%;--width:${box.width}%;--height:${box.height}%;`;
---

<main id="desktop-main" class={`exact-board exact-board-${variant}`} aria-label={`${variantNames[variant]} desktop design`}>
  <picture>
    <source media="(min-width: 851px)" srcset={board.src} />
    <img
      class="exact-board-image"
      src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs="
      width={board.width}
      height={board.height}
      alt={`${variantNames[variant]} full-page AWAR3 design board`}
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </picture>

  {Object.entries(anchorTops[variant]).map(([id, top]) => (
    <span class="exact-anchor" id={`exact-${id}`} style={`--top:${top}%;`} aria-hidden="true"></span>
  ))}

  {Object.entries(navBoxes[variant]).map(([id, box]) => (
    <a class="exact-hotspot" href={`#exact-${id}`} style={boxStyle(box)} aria-label={`Go to ${id}`}></a>
  ))}

  {ctaBoxes[variant].map((box) => (
    <a class="exact-hotspot" href={mailto} style={boxStyle(box)} aria-label={content.contact.cta}></a>
  ))}

  <a
    class="exact-hotspot"
    href={`mailto:${content.contact.email}`}
    style={boxStyle(emailBoxes[variant])}
    aria-label={`Email ${content.contact.email}`}
  ></a>
</main>
